{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["@types/bun", "bun-types"],
    "noEmit": true
  },
  "include": ["src", "plugins", "scripts", "global.d.ts"],
  "exclude": ["public", "scripts/ssg/__fixtures__/site"]
}
