# Cabeçalhos de segurança (sintaxe do Cloudflare Pages e do Netlify)
/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# Cache longo para arquivos com hash no nome (sintaxe do Cloudflare Pages e do Netlify)
/_img/*
  Cache-Control: public, max-age=31536000, immutable
/client-*.js
  Cache-Control: public, max-age=31536000, immutable
/styles-*.css
  Cache-Control: public, max-age=31536000, immutable
