{
  "name": "slash-ssg",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "bun run scripts/build.ts",
    "build:prod": "bun run gate && bun run build",
    "gate": "bun run scripts/content-gate.ts",
    "preview": "bun run scripts/preview.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test src/ scripts/ examples/",
    "test:e2e": "playwright test",
    "test:all": "bun run test && bun run test:e2e",
    "ui:build": "bun run examples/slash-ui/build.ts",
    "ui:serve": "bun run examples/slash-ui/serve.ts"
  },
  "dependencies": {
    "@biomejs/biome": "^2.3.11",
    "@_bashell/slash": "workspace:*",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.3.3",
    "@playwright/test": "^1.57.0",
    "@types/bun": "latest",
    "playwright": "^1.57.0",
    "typescript": "^5.6.2",
    "@_bashell/slash-ui": "workspace:*"
  }
}
